# Set the final public HTTPS origin before building for deployment.
# GitHub Pages public site. Leave empty for a private-only preview.
SITE_URL=https://360-design.github.io
# Public form endpoint, not an API key. Required for build:pages.
# Leave empty locally to keep using the SQLite waitlist.
VITE_FORMSPREE_ENDPOINT=
# Optional HTML-tag verification content from the search-engine dashboards.
# These are public ownership tokens, not account credentials.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
